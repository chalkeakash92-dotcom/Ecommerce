# Multi-stage build for Angular application
FROM node:20-alpine AS build
WORKDIR /app

# Copy package files and install dependencies
COPY package*.json ./
RUN npm ci

# Copy source and build Angular app for production
COPY . .
RUN npm run build -- --configuration production

# Serving stage with Nginx
FROM nginx:alpine
COPY --from=build /app/dist/ecommerce-frontend/browser /usr/share/nginx/html
# If using Angular older versions:
# COPY --from=build /app/dist/ecommerce-frontend /usr/share/nginx/html

# Custom nginx config for SPA routing (optional)
# COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemonoff;"]
